# Public build settings for Vercel PREVIEW deployments (the `dev` branch and every
# other non-production branch): the development backend. Compiled into the
# JavaScript every browser downloads. NEVER put a secret here; this file is
# committed. Production builds read .env.production instead.
VITE_API_URL=https://api-dev.geneush.com
