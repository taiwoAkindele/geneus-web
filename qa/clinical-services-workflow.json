[
  {
    "role": "doctor",
    "path": "/clinical/patients",
    "name": "clinical-patients",
    "assert": "(()=>{const b=[...document.querySelectorAll('aside nav[aria-label=\"Modules\"] button')].find(x=>x.textContent.trim()==='Clinical');return b&&b.getAttribute('aria-expanded')==='true'?[...document.getElementById(b.getAttribute('aria-controls')).querySelectorAll('a')].map(a=>a.textContent.trim()).join('|'):'';})()==='Patients|Wards & admissions|Laboratory|Pharmacy|Referrals|Documents'&&![...document.querySelectorAll('aside a')].some(a=>a.textContent.trim()==='Overview')",
    "description": "Clinical opens in the sidebar listing Patients first, without an Overview page, Results ready or the unit queue"
  },
  {
    "assert": "['Allergies','Active problems','Status','Last visit','View chart','Penicillin','Hypertension'].every(t=>document.body.innerText.includes(t))&&!document.body.innerText.includes('Review duplicate')&&![...document.querySelectorAll('button')].some(b=>b.textContent.trim()==='Add patient')&&!/\\d+ of \\d+ patients/.test(document.body.innerText)",
    "description": "Clinical patients table shows allergies, problems and care status, without front-desk actions or a row count"
  },
  {
    "path": "/laboratory",
    "name": "laboratory-open",
    "assert": "document.body.innerText.includes('Open requests')&&document.body.innerText.includes('Completed requests')&&!document.querySelector('main select')&&document.querySelectorAll('main input').length===1&&!['Wards & admissions','Appointments','Patients'].some(t=>[...document.querySelectorAll('main button')].some(b=>b.textContent.trim()===t))&&document.body.innerText.includes('Demo Second Patient')&&document.body.innerText.includes('Synthetic test')&&document.body.innerText.includes('Awaiting results')",
    "description": "Laboratory shows open and completed requests with only a search"
  },
  {
    "fill": {
      "label": "Search",
      "value": "synthetic"
    },
    "assert": "document.body.innerText.includes('Demo Second Patient')",
    "description": "Search finds a request by test name"
  },
  {
    "fill": {
      "label": "Search",
      "value": "no such test"
    },
    "assert": "document.body.innerText.includes('No requests match this search')",
    "description": "Search narrows requests"
  },
  {
    "path": "/pharmacy",
    "name": "pharmacy",
    "assert": "document.body.innerText.includes('Open requests')&&document.body.innerText.includes('Completed requests')&&!document.querySelector('main select')&&document.querySelectorAll('main input').length===1",
    "description": "Pharmacy shows open and completed requests with only a search"
  },
  {
    "path": "/admissions",
    "name": "wards",
    "assert": "!document.body.innerText.includes('Clinical patient list')&&!document.body.innerText.includes('Show all patients')",
    "description": "Wards & admissions has no patient list link"
  },
  {
    "path": "/laboratory",
    "click": "Record results",
    "name": "lab-request",
    "assert": "window.designAudit.path==='/laboratory/request'&&[...document.querySelectorAll('a,button')].some(b=>b.textContent.trim()==='Back to Laboratory')&&document.body.innerText.includes('Request')&&document.body.innerText.includes('Enter results')&&!document.body.innerText.includes('Continue to diagnosis')&&!document.body.innerText.includes('Vital signs')",
    "description": "Record results opens the Laboratory request screen, without the visit steps"
  },
  {
    "fill": {
      "label": "Synthetic test",
      "value": "Negative"
    }
  },
  {
    "click": "Preview report"
  },
  {
    "assert": "document.body.innerText.includes('1 result, 0 flagged')&&document.body.innerText.includes('alerted when this device syncs')",
    "description": "The preview names the results and flags before the single publish action"
  },
  {
    "click": "Publish results",
    "evaluate": "[...document.querySelectorAll('button')].find(b=>(b.getAttribute('aria-label')||'').startsWith('Notifications')).click();true",
    "assert": "window.designAudit.path==='/laboratory'&&document.body.innerText.includes('Open requests')&&document.body.style.overflow!=='hidden'",
    "description": "Publishing from the Laboratory returns to the Laboratory queue, and the page scrolls again"
  },
  {
    "name": "result-alert",
    "assert": "document.body.innerText.includes('Synthetic test result ready')&&document.body.innerText.includes('Demo Second Patient')",
    "description": "The ordering clinician is alerted in the bell when a result is ready"
  },
  {
    "key": "Escape",
    "path": "/encounters/record?patient=QA-PHC-000002-K3&visit=encounter%3Alab&task=vitals",
    "name": "result-banner",
    "assert": "document.body.innerText.includes('Synthetic test result ready')&&[...document.querySelectorAll('button')].some(b=>b.textContent.trim()==='Review results')",
    "description": "An open visit shows a banner when a result is ready"
  },
  {
    "click": "Review results"
  },
  {
    "click": "Review & sign result review"
  },
  {
    "click": "Confirm & lock",
    "assert": "!document.body.innerText.includes('Synthetic test result ready')&&![...document.querySelectorAll('button')].some(b=>(b.getAttribute('aria-label')||'').includes('unread'))",
    "description": "The alert and banner end once the result is reviewed"
  },
  {
    "path": "/laboratory?tab=completed",
    "assert": "document.body.innerText.includes('Demo Second Patient')&&document.body.innerText.includes('Resulted')",
    "description": "A resulted request moves to Completed requests"
  },
  {
    "click": "View",
    "name": "lab-request-completed",
    "assert": "window.designAudit.path==='/laboratory/request'&&document.body.innerText.includes('Published results')&&document.body.innerText.includes('Negative')&&!document.body.innerText.includes('Enter results')",
    "description": "A completed request opens read-only with its published results"
  },
  {
    "path": "/pharmacy",
    "evaluate": "window.seedPrescriptionScenario()",
    "assert": "document.body.innerText.includes('Amoxicillin 500 mg')",
    "description": "A prescription waits at the Pharmacy"
  },
  {
    "click": "Dispense",
    "name": "dispense",
    "assert": "window.designAudit.path==='/pharmacy/request'&&[...document.querySelectorAll('a,button')].some(b=>b.textContent.trim()==='Back to Pharmacy')&&document.body.innerText.includes('Dispense medication')&&document.body.innerText.includes('Amoxicillin 500 mg')&&!document.body.innerText.includes('Vital signs')",
    "description": "Dispense opens the Pharmacy dispense screen, without the visit steps"
  },
  {
    "evaluate": "[...document.querySelectorAll('button[aria-pressed]')].find(b=>b.textContent.includes('Amoxicillin')).click();true"
  },
  {
    "click": "Review & sign dispense"
  },
  {
    "click": "Confirm & lock",
    "assert": "window.designAudit.path==='/pharmacy'&&window.designAudit.rows.encounter_entries.some(r=>r.step==='dispense'&&r.encounterId==='encounter:rx')&&document.body.style.overflow!=='hidden'",
    "description": "Dispensing is saved to the visit and returns to the Pharmacy, and the page scrolls again"
  },
  {
    "path": "/pharmacy?tab=completed",
    "click": "View",
    "assert": "window.designAudit.path==='/pharmacy/request'&&document.body.innerText.includes('Dispensed')&&document.body.innerText.includes('Signed by')&&!document.body.innerText.includes('Review & sign')",
    "description": "A dispensed prescription opens read-only"
  },
  {
    "width": 320,
    "path": "/pharmacy/request?patient=QA-PHC-000002-K3&visit=encounter%3Arx",
    "name": "dispense-phone",
    "assert": "document.documentElement.scrollWidth<=320",
    "description": "The dispense screen fits a 320px phone"
  },
  {
    "width": 320,
    "path": "/laboratory",
    "name": "laboratory-phone",
    "assert": "document.documentElement.scrollWidth<=320",
    "description": "Laboratory fits a 320px phone"
  }
]
