[
  { "role": "doctor", "width": 1440, "path": "/home", "name": "nav-home-desktop",
    "assert": "(()=>{const items=[...document.querySelectorAll('aside nav[aria-label=\"Modules\"] a, aside nav[aria-label=\"Modules\"] button')].map(n=>n.textContent.trim());return items[0]==='Home'&&items.includes('Front Desk')&&items.includes('Clinical')&&!items.includes('Overview')&&!items.includes('All modules')&&![...document.querySelectorAll('nav[aria-label=\"Your modules\"]')].some(n=>n.getClientRects().length);})()",
    "description": "Desktop: the sidebar lists Home and every module on Home itself; module cards are not repeated" },
  { "assert": "!document.querySelector('aside button[aria-label=\"Your profile and sign out\"]')&&Boolean(document.querySelector('header button[aria-label^=\"Your profile\"]'))",
    "description": "Profile and sign-out are in the top bar only" },
  { "click": "Clinical", "assert": "(()=>{const b=[...document.querySelectorAll('aside button')].find(x=>x.textContent.trim()==='Clinical');return b.getAttribute('aria-expanded')==='true'&&document.getElementById(b.getAttribute('aria-controls')).innerText.includes('Laboratory')&&window.designAudit.path==='/home';})()",
    "description": "Clicking a module opens its pages without leaving the current page" },
  { "click": "Laboratory", "selector": "aside a", "name": "nav-clinical-lab",
    "assert": "window.designAudit.path==='/laboratory'&&[...document.querySelectorAll('aside button')].find(x=>x.textContent.trim()==='Clinical').getAttribute('aria-expanded')==='true'&&document.querySelector('aside a[aria-current=\"page\"]').textContent.trim()==='Laboratory'",
    "description": "A page opens from the sidebar; its module stays open with the page highlighted" },
  { "click": "Front Desk", "assert": "[...document.querySelectorAll('aside button')].find(x=>x.textContent.trim()==='Front Desk').getAttribute('aria-expanded')==='true'&&[...document.querySelectorAll('aside button')].find(x=>x.textContent.trim()==='Clinical').getAttribute('aria-expanded')==='false'",
    "description": "One module is open at a time" },
  { "click": "Clinical" },
  { "click": "Patients", "selector": "aside a", "assert": "window.designAudit.path==='/patients/search'&&[...document.querySelectorAll('aside button')].find(x=>x.textContent.trim()==='Clinical').getAttribute('aria-expanded')==='true'&&document.body.innerText.includes('Allergies')",
    "description": "A page shared by several modules keeps the module it was opened from" },
  { "click": "Inventory", "selector": "aside a", "assert": "window.designAudit.path==='/stock'",
    "description": "A one-page module opens its page directly" },
  { "path": "/workspace/clinical", "assert": "window.designAudit.path==='/patients/search'&&[...document.querySelectorAll('aside button')].find(x=>x.textContent.trim()==='Clinical').getAttribute('aria-expanded')==='true'",
    "description": "Old Overview addresses open the module's first page in that module" },
  { "role": "doctor", "width": 390, "path": "/laboratory", "name": "nav-phone-bar",
    "assert": "(()=>{const bar=document.querySelector('nav[aria-label=\"Clinical mobile navigation\"]');const labels=[...bar.querySelectorAll('a, button')].map(n=>n.textContent.trim());return labels.join('|')==='Home|Patients|Wards & admissions|More'&&!document.querySelector('select[aria-label=\"Switch module\"]')&&document.documentElement.scrollWidth<=innerWidth;})()",
    "description": "Phone: Home, the module's two main pages and More; no extra module bar" },
  { "label": "More navigation", "name": "nav-phone-more",
    "assert": "(()=>{const sheet=document.querySelector('dialog[open]');const items=[...sheet.querySelectorAll('nav[aria-label=\"Modules\"] a, nav[aria-label=\"Modules\"] button')].map(n=>n.textContent.trim());return items[0]==='Home'&&items.includes('Front Desk')&&items.includes('Laboratory')&&sheet.innerText.includes('Sync');})()",
    "description": "Phone: More lists every module with the current one open" },
  { "click": "Pharmacy", "selector": "a", "assert": "window.designAudit.path==='/pharmacy'&&!document.querySelector('dialog[open]')",
    "description": "Choosing a page from More closes the menu" }
]
