[
  { "role": "facility_admin", "width": 1440, "path": "/home", "evaluate": "window.seedSetupScenario()" },
  { "path": "/settings/facility", "name": "facility-edit-button-desktop", "assert": "!document.querySelector('input[name=facility_name]')&&Boolean([...document.querySelectorAll('button')].find(b=>b.textContent==='Edit facility details'))", "description": "Facility details have an Edit button without an inline form" },
  { "click": "Edit facility details", "name": "facility-edit-form-desktop", "assert": "document.querySelector('dialog[open] input[name=facility_name]').value==='Synthetic clinical facility'&&document.querySelector('dialog[open]').getAttribute('aria-modal')==='true'", "description": "The button opens the existing details in a modal form" },
  { "fill": { "label": "Facility name", "value": "Synthetic updated facility" } },
  { "click": "Cancel", "assert": "document.querySelector('dialog[open]').innerText.includes('Discard unsaved changes?')&&window.designAudit.rows.facilities[0].name==='Synthetic clinical facility'", "description": "Cancel protects unsaved facility edits" },
  { "click": "Keep editing" },
  { "click": "Save changes", "assert": "!document.querySelector('dialog[open]')&&document.querySelector('section[aria-labelledby=facility-details-heading] dl').innerText.includes('Synthetic updated facility')", "description": "Saving closes the panel and updates the facility summary" },
  { "click": "Edit facility details", "fill": { "label": "Facility name", "value": "" } },
  { "click": "Save changes", "assert": "Boolean(document.querySelector('dialog[open] [role=alert]'))&&window.designAudit.rows.facilities[0].name==='Synthetic updated facility'", "description": "Invalid details stay open without changing the saved facility" },
  { "click": "Cancel" },
  { "click": "Discard changes", "assert": "!document.querySelector('dialog[open]')&&document.activeElement.textContent==='Edit facility details'", "description": "Discard closes the form and returns focus to its button" },
  { "role": "doctor", "path": "/patients/new", "assert": "(()=>{const s=document.querySelector('select[name=sex]');return s&&s.value===''&&s.required&&JSON.stringify([...s.options].map(o=>o.textContent))===JSON.stringify(['Choose sex','Female','Male'])&&!document.querySelector('[role=radiogroup][aria-label=Sex]')})()", "description": "Registration uses a gender select with explicit Female/Male options and no preselected value" },
  { "evaluate": "(document.querySelector('form').requestSubmit(),true)", "assert": "document.querySelector('select[name=sex]').getAttribute('aria-invalid')==='true'&&document.body.innerText.includes('Choose the patient’s sex')", "description": "Identified registration still requires a deliberate sex selection" },
  { "fill": { "label": "Sex", "value": "F" }, "assert": "document.querySelector('select[name=sex]').value==='F'&&document.querySelector('select[name=sex]').getAttribute('aria-invalid')!=='true'", "description": "The select updates the registration value and clears its validation error" },
  { "path": "/home" },
  { "path": "/patients/new", "assert": "document.querySelector('select[name=sex]').value==='F'", "description": "The selected value survives navigating away and returning to the draft" },
  { "click": "Clear form" },
  { "evaluate": "(document.querySelector('input[type=checkbox]').click(),true)", "assert": "document.querySelector('select[name=sex]').value===''&&!document.querySelector('select[name=sex]').required&&document.querySelector('select[name=sex]').selectedOptions[0].textContent==='Unknown'", "description": "Provisional registration retains an explicit Unknown choice" },
  { "fill": { "label": "Reason for provisional registration", "value": "Synthetic unidentified patient for dropdown check" } },
  { "click": "Create provisional record", "assert": "window.designAudit.path==='/patients/profile'&&window.designAudit.rows.patients.some(p=>p.identityStatus==='provisional'&&p.sex==null)", "description": "A provisional patient can still be registered without inventing a sex" },
  { "role": "facility_admin", "width": 390, "path": "/home", "evaluate": "window.seedSetupScenario()" },
  { "path": "/settings/facility", "click": "Edit facility details", "name": "facility-edit-form-phone", "assert": "document.documentElement.scrollWidth<=innerWidth&&document.querySelector('dialog[open]').getBoundingClientRect().width<=innerWidth", "description": "The facility form panel fits at 390px" },
  { "click": "Cancel" },
  { "role": "doctor", "path": "/patients/new", "name": "patient-sex-select-phone", "assert": "document.documentElement.scrollWidth<=innerWidth&&Boolean(document.querySelector('select[name=sex]'))", "description": "Registration's gender select fits at 390px" },
  { "role": "facility_admin", "width": 320, "path": "/home", "evaluate": "window.seedSetupScenario()" },
  { "path": "/settings/facility", "click": "Edit facility details", "name": "facility-edit-form-320", "assert": "document.documentElement.scrollWidth<=innerWidth", "description": "The facility form panel fits at 320px" },
  { "click": "Cancel" },
  { "role": "doctor", "path": "/patients/new", "name": "patient-sex-select-320", "assert": "document.documentElement.scrollWidth<=innerWidth&&Boolean(document.querySelector('select[name=sex]'))", "description": "Registration's gender select fits at 320px" },
  { "finish": true }
