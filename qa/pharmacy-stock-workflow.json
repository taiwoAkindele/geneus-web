[
  { "role": "pharmacy_staff", "path": "/pharmacy", "evaluate": "window.seedPharmacyScenario()" },
  { "path": "/pharmacy/request?patient=QA-PHC-000001-K2&visit=visit%3Apharmacy-demo", "name": "pharmacy-start", "assert": "document.body.innerText.includes('Supply medicines')&&document.body.innerText.includes('Still needed: 20')", "description": "Pharmacy opens a plain quantity-based medicine card" },
  { "click": "Supply medicine" },
  { "fill": { "label": "Medicine in stock", "value": "stock:pharmacy-demo" } },
  { "fill": { "label": "Giving now", "value": "5" } },
  { "click": "Review & save", "name": "pharmacy-partial-review", "assert": "document.querySelector('dialog[open]').innerText.includes('Giving now: 5 tablets')&&document.querySelector('dialog[open]').innerText.includes('More of this medicine is still needed')&&document.querySelector('dialog[open]').innerText.includes('Bill added')", "description": "The review shows the actual quantity and bill without marking a partial supply complete" },
  { "click": "Confirm & save pharmacy record", "assert": "!document.querySelector('dialog[open]')&&window.designAudit.rows.stock_movements.some(e=>e.dispenseEntryId&&Number(e.change)===-5)&&window.designAudit.rows.charges.some(e=>e.dispenseEntryId&&Number(e.amountMinor)===50000)&&document.body.innerText.includes('Still needed: 15')", "description": "One save creates one supply, its stock deduction and its quantity-based bill" },
  { "path": "/pharmacy", "assert": "document.body.innerText.includes('Synthetic medicine')&&document.body.innerText.includes('Part supplied')", "description": "A partial supply stays in the open pharmacy queue" },
  { "path": "/pharmacy/request?patient=QA-PHC-000001-K2&visit=visit%3Apharmacy-demo" },
  { "click": "Supply medicine" },
  { "fill": { "label": "Medicine in stock", "value": "stock:pharmacy-demo" } },
  { "fill": { "label": "Giving now", "value": "15" } },
  { "click": "Review & save" },
  { "click": "Confirm & save pharmacy record", "assert": "document.body.innerText.includes('Still needed: 0')&&window.designAudit.rows.stock_movements.filter(e=>e.dispenseEntryId).reduce((n,e)=>n+Number(e.change),0)===-20&&window.designAudit.rows.charges.filter(e=>e.dispenseEntryId).reduce((n,e)=>n+Number(e.amountMinor),0)===200000", "description": "A top-up bills and deducts only the additional quantity" },
  { "evaluate": "document.querySelector('details summary').click();true" },
  { "click": "Record a return" },
  { "fill": { "label": "Quantity returned", "value": "2" } },
  { "fill": { "label": "Reason", "value": "Synthetic return recorded after review" } },
  { "fill": { "label": "Add the return back to recorded stock?", "value": "true" } },
  { "click": "Review & save", "name": "pharmacy-return-review", "assert": "document.querySelector('dialog[open]').innerText.includes('Patient credit')&&!document.querySelector('dialog[open]').innerText.includes('minor units')", "description": "A medicine return shows a readable patient credit and separates the cash refund" },
  { "click": "Confirm & save pharmacy record", "assert": "window.designAudit.rows.billing_adjustments.some(e=>e.dispenseEntryId&&Number(e.amountMinor)===20000)&&window.designAudit.rows.stock_movements.filter(e=>e.dispenseEntryId).reduce((n,e)=>n+Number(e.change),0)===-18&&!window.designAudit.rows.payments.some(e=>e.dispenseEntryId)", "description": "A return restores only the selected stock quantity and credits the original bill" },
  { "reload": true, "width": 320, "path": "/pharmacy", "evaluate": "window.seedPharmacyScenario()" },
  { "path": "/pharmacy/request?patient=QA-PHC-000001-K2&visit=visit%3Apharmacy-demo" },
  { "click": "Supply medicine", "name": "pharmacy-phone-form", "assert": "document.documentElement.scrollWidth<=320", "description": "The editable pharmacy form fits a 320px phone" },
  { "fill": { "label": "Where is this medicine supplied from?", "value": "untracked" } },
  { "fill": { "label": "Quantity unit", "value": "tablets" } },
  { "fill": { "label": "Giving now", "value": "5" } },
  { "click": "Review & save" },
  { "click": "Confirm & save pharmacy record", "assert": "window.designAudit.rows.encounter_entries.some(e=>e.pharmacyVersion===1&&JSON.parse(e.values).supply.billing==='unpriced')&&!window.designAudit.rows.stock_movements.some(e=>e.dispenseEntryId)&&!window.designAudit.rows.charges.some(e=>e.dispenseEntryId)", "description": "A hospital supply can be recorded before stock tracking and pricing are configured" },
  { "path": "/pharmacy?tab=pricing", "assert": "document.body.innerText.includes('Needs a price (1)')&&document.body.innerText.includes('Synthetic medicine')", "description": "Unpriced supplies remain visible in a dedicated follow-up list" },
