[
  { "role": "facility_admin", "width": 1440, "path": "/home", "evaluate": "window.seedSetupScenario()" },
  { "path": "/settings/facility", "click": "Edit facility details", "name": "facility-form-desktop", "assert": "(()=>{const d=document.querySelector('dialog[open]'), f=d.querySelector('form'), controls=[...f.querySelectorAll('input,select')];return f.querySelector('select[name=facility_level]').value==='phc'&&controls.indexOf(f.querySelector('[name=facility_country]'))<controls.indexOf(f.querySelector('[name=facility_state]'))&&controls.indexOf(f.querySelector('[name=facility_country]'))<controls.indexOf(f.querySelector('[name=facility_lga]'))&&f.querySelector('select[name=facility_time_zone]').value==='Africa/Lagos'})()", "description": "Level is a select, country precedes state and LGA, and time zone is part of the edit form" },
  { "assert": "(()=>{const d=document.querySelector('dialog[open]'),p=d.firstElementChild,r=p.getBoundingClientRect();return d.parentElement===document.body&&Math.abs(d.getBoundingClientRect().top)<1&&Math.abs(r.top)<1&&Math.abs(r.bottom-innerHeight)<1&&getComputedStyle(d).marginTop==='0px'})()", "description": "The shared side modal is flush with the top and bottom of the viewport without page margins" },
  { "evaluate": "(()=>{const d=document.querySelector('dialog[open]');const buttons=[...d.querySelectorAll('form button')];const s=buttons.find(b=>b.textContent==='Save changes'),c=buttons.find(b=>b.textContent==='Cancel');s.scrollIntoView({block:'center'});const a=s.getBoundingClientRect(),b=c.getBoundingClientRect();return window.facilityActionsAligned=Math.abs(a.top-b.top)<1&&a.right<b.left})()", "assert": "window.facilityActionsAligned", "description": "Save and Cancel share the same row" },
  { "fill": { "label": "Level of care", "value": "general_hospital" } },
  { "fill": { "label": "Country", "value": "GH" }, "assert": "document.querySelector('[name=facility_currency]').value==='GHS'&&document.querySelector('[name=facility_time_zone]').value==='Africa/Lagos'", "description": "Changing country updates the default currency while preserving a configured time zone" },
  { "fill": { "label": "Time zone", "value": "Africa/Accra" }, "assert": "Boolean(document.querySelector('[name=facility_time_zone_reason]'))&&[...document.querySelectorAll('dialog[open] button')].find(b=>b.textContent==='Save changes').disabled", "description": "A time-zone correction still requires its reason and confirmation" },
  { "fill": { "label": "Reason for time zone correction", "value": "Correcting the facility location" } },
  { "evaluate": "(document.querySelector('dialog[open] input[type=checkbox]').click(),window.savedFormFetch=window.fetch,window.fetch=async(input,init)=>{if(String(input).endsWith('/facility/time-zone')){window.zoneSavePayload=JSON.parse(init.body);return new Response(JSON.stringify({error:'temporarily_unavailable',message:'Synthetic time-zone outage'}),{status:503,headers:{'content-type':'application/json'}})}return window.savedFormFetch(input,init)},true)" },
  { "click": "Save changes", "assert": "document.querySelector('dialog[open] [role=alert]').textContent.includes('Facility details were saved, but the time zone could not be changed')&&document.querySelector('[name=facility_time_zone]').value==='Africa/Accra'&&window.designAudit.rows.facilities[0].timeZone==='Africa/Lagos'&&window.zoneSavePayload.confirm===true&&window.zoneSavePayload.reason==='Correcting the facility location'", "description": "A partial save keeps the time-zone edit and explains which part failed" },
  { "evaluate": "(window.fetch=window.savedFormFetch,true)" },
  { "click": "Save changes", "assert": "!document.querySelector('dialog[open]')&&window.designAudit.rows.facilities[0].timeZone==='Africa/Accra'&&window.designAudit.rows.facilities[0].level==='general_hospital'&&document.querySelector('section[aria-labelledby=facility-details-heading] dl').innerText.includes('Africa/Accra')", "description": "Retry saves the selected level, country and time zone through the same form" },
  { "path": "/setup?step=facility", "assert": "Boolean(document.querySelector('select[name=facility_level]'))&&document.querySelector('select[name=facility_time_zone]').value==='Africa/Accra'", "description": "Setup uses the same level select and time-zone form" },
  { "path": "/settings/facility?view=services", "click": "Add care services", "evaluate": "([...document.querySelectorAll('#care-services-add-section button')].find(b=>b.textContent.startsWith('General outpatient consultation')).click(),true)", "name": "shared-center-modal-desktop", "assert": "(()=>{const d=document.querySelector('dialog[open]');return d.parentElement===document.body&&Math.abs(d.getBoundingClientRect().top)<1&&getComputedStyle(d).marginTop==='0px'&&d.firstElementChild.getBoundingClientRect().top>=0})()", "description": "Centered modals also avoid margins inherited from page sections" },
  { "click": "Cancel" },
  { "width": 390, "path": "/home", "evaluate": "window.seedSetupScenario()" },
  { "path": "/settings/facility", "click": "Edit facility details", "name": "facility-form-phone", "assert": "(()=>{const d=document.querySelector('dialog[open]'),p=d.firstElementChild,r=p.getBoundingClientRect();const buttons=[...d.querySelectorAll('form button')],s=buttons.find(b=>b.textContent==='Save changes'),c=buttons.find(b=>b.textContent==='Cancel');return document.documentElement.scrollWidth<=innerWidth&&Math.abs(r.top)<1&&Math.abs(r.bottom-innerHeight)<1&&Math.abs(s.getBoundingClientRect().top-c.getBoundingClientRect().top)<1})()", "description": "The phone form fills the viewport and keeps actions side by side" },
  { "click": "Cancel" },
  { "width": 320, "path": "/home", "evaluate": "window.seedSetupScenario()" },
  { "path": "/settings/facility", "click": "Edit facility details", "name": "facility-form-320", "assert": "(()=>{const d=document.querySelector('dialog[open]'),p=d.firstElementChild,r=p.getBoundingClientRect();const buttons=[...d.querySelectorAll('form button')],s=buttons.find(b=>b.textContent==='Save changes'),c=buttons.find(b=>b.textContent==='Cancel');return document.documentElement.scrollWidth<=innerWidth&&Math.abs(r.top)<1&&Math.abs(r.bottom-innerHeight)<1&&Math.abs(s.getBoundingClientRect().top-c.getBoundingClientRect().top)<1})()", "description": "The 320px form stays flush to the viewport without action wrapping" },
