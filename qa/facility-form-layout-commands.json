  { "click": "Record arrival", "assert": "document.querySelectorAll('dialog[open]').length===2&&[...document.querySelectorAll('dialog[open]')].every(d=>d.parentElement===document.body&&Math.abs(d.getBoundingClientRect().top)<1)", "description": "Nested appointment dialogs both use the viewport overlay without page margins" },
  { "click": "Review change", "key": "Escape", "code": 27, "assert": "document.querySelectorAll('dialog[open]').length===2&&[...document.querySelectorAll('dialog[open]')].at(-1).innerText.includes('Discard unsaved changes?')", "description": "Escape protects edits in the active nested dialog and keeps the underlying record open" },
  { "click": "Discard changes", "assert": "document.querySelectorAll('dialog[open]').length===1&&document.body.style.overflow==='hidden'", "description": "Closing the nested dialog preserves the parent dialog and its scroll lock" },
  { "key": "Escape", "code": 27, "assert": "document.querySelectorAll('dialog[open]').length===0&&document.body.style.overflow!=='hidden'", "description": "Closing the last dialog restores page scrolling" },
