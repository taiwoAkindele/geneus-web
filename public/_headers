# Cloudflare Pages headers (Vercel reads vercel.json instead).
# Pages serves index.html for unknown paths on its own, so deep links need no
# _redirects file. The service worker, the page and the manifest must always be
# revalidated, or phones keep an old version; hashed assets never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
